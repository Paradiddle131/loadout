#!/usr/bin/env python3
"""Report upstream changes to the skills this repo adapted from someone else's; never apply them.

A skill that started from another repo's says so in its SKILL.md frontmatter:

    metadata:
      upstream: https://github.com/<owner>/<repo>
      upstream-path: <folder of the skill in that repo>
      upstream-commit: <the commit our copy last took in>

For each, this fetches the upstream repo (a blob-less clone cached under ~/.cache) and lists the upstream
commits since the pinned one that touch the skill's folder. Merging them is a by-hand edit: read the diff
(`--diff <skill>`), carry over what fits the local changes, then set `upstream-commit` to the commit printed.

Usage: bin/check-upstream [--diff <skill>]   (exit 0 always; it only reports)
"""

import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / ROOT.name / "upstream"


def frontmatter(skill_md):
    text = skill_md.read_text()
    if not text.startswith("---\n"):
        return {}
    block = text[4:text.index("\n---\n", 4)]
    meta, inside = {}, False
    for line in block.splitlines():
        if line.startswith("metadata:"):
            inside = True
            continue
        if inside and line.startswith("  "):
            key, _, value = line.strip().partition(":")
            meta[key] = value.strip().strip('"')
        elif inside:
            inside = False
    return meta


def git(*args, cwd=None):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout


def fetch(url):
    dest = CACHE / re.sub(r"[^A-Za-z0-9._-]+", "_", url.split("://", 1)[-1])
    if dest.exists():
        git("fetch", "-q", "--filter=blob:none", "origin", cwd=dest)
    else:
        dest.parent.mkdir(parents=True, exist_ok=True)
        git("clone", "-q", "--filter=blob:none", "--no-checkout", url, str(dest))
    return dest


def main():
    want_diff = sys.argv[2] if len(sys.argv) > 2 and sys.argv[1] == "--diff" else None
    tracked = []
    for skill_md in sorted(ROOT.glob("**/skills/*/SKILL.md")):
        meta = frontmatter(skill_md)
        if meta.get("upstream"):
            tracked.append((skill_md.parent.name, meta))
    for name, meta in tracked:
        if want_diff and name != want_diff:
            continue
        url, path, pin = meta["upstream"], meta.get("upstream-path", ""), meta.get("upstream-commit", "")
        try:
            repo = fetch(url)
            head = git("rev-parse", "origin/HEAD", cwd=repo).strip()
            log = git("log", "--format=%h %ad %s", "--date=short", f"{pin}..{head}", "--", path, cwd=repo)
        except subprocess.CalledProcessError as e:
            print(f"{name}: could not read {url}: {e.stderr.strip()}")
            continue
        commits = log.splitlines()
        if not commits:
            print(f"{name}: up to date with {url} ({pin[:7]})")
            continue
        print(f"{name}: {len(commits)} upstream commit(s) since {pin[:7]} touch {path}; latest is {head}")
        for c in commits:
            print(f"  {c}")
        if want_diff:
            print(git("diff", f"{pin}..{head}", "--", path, cwd=repo))
    if not tracked:
        print("check-upstream: no skill names an upstream")
    return 0


if __name__ == "__main__":
    sys.exit(main())
