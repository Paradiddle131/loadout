#!/usr/bin/env bash
# pre-commit of the repos a cloud session works on, set as their core.hooksPath by the session-start hook
# (only in a repo with no hooks of its own): a commit may not add the repo's owner literally, nor a process id
# (an issue, PR, phase or decision reference) to a checked-in file, nor a secret (gitleaks over what is staged,
# when cloud/setup.sh's pinned gitleaks or another is on the path; the repo's .gitleaks.toml and .gitleaksignore apply).
set -uo pipefail
d=$(cd "$(dirname "$0")" && pwd)
status=0
bash "$d/check-portable.sh" || status=1
if command -v python3 >/dev/null; then
  python3 "$d/check-process-ids.py" || status=1
else
  echo "pre-commit: python3 is not installed, so added lines were NOT checked for process ids" >&2
fi
gitleaks=$(command -v gitleaks || { [ -x "$HOME/.local/bin/gitleaks" ] && echo "$HOME/.local/bin/gitleaks"; } || true)
if [ -n "$gitleaks" ]; then
  "$gitleaks" protect --staged --no-banner --redact -v || status=1
else
  echo "pre-commit: gitleaks is not installed, so staged files were NOT scanned for secrets" >&2
fi
exit $status
